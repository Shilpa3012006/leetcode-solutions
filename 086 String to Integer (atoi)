#recursion method
class Solution:
    def myAtoi(self, s: str) -> int:
        INT_MAX = 2**31 - 1
        INT_MIN = -2**31
        n = len(s)

        i = 0
        while i < n and s[i] == ' ':
            i += 1

        if i == n:
            return 0

        sign = 1
        if s[i] == '-':
            sign = -1
            i += 1
        elif s[i] == '+':
            i += 1

        def helper(idx, num):
            if idx == n or not s[idx].isdigit():
                return sign * num

            digit = ord(s[idx]) - ord('0')

            # Overflow
            if num > (INT_MAX - digit) // 10:
                return INT_MAX if sign == 1 else INT_MIN

            return helper(idx + 1, num * 10 + digit)

        return helper(i, 0)
