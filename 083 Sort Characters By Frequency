class Solution:
    def frequencySort(self, s: str) -> str:
        freq={}
        for c in s:
            freq[c]=freq.get(c,0)+1
        bucket = [[] for _ in range(len(s) + 1)]

        for ch, count in freq.items():
            bucket[count].append(ch)

        ans = []

        for i in range(len(s), 0, -1):
            for ch in bucket[i]:
                ans.append(ch * i)

        return ''.join(ans) 
                
