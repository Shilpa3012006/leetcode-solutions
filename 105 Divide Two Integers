class Solution:
    def divide(self, dividend: int, divisor: int) -> int:
        sing=1
        INT_MAX=2**31-1
        INT_MIN=-2**31
        ans=0
        if dividend==divisor:
            return 1
        if (dividend<0 and divisor>0) or (dividend>0 and divisor<0):
            sing=-1
        n=abs(dividend)
        d=abs(divisor)
        while n>=d:
            count=0
            while n>(d<<count+1):
                count+=1
            ans+=(1<<count)
            n-=d<<count
        if ans>=2**31 and sing==1:
            return INT_MAX
        if ans>=2**31 and sing==-1:
            return INT_MIN
        
        return ans if sing == 1 else -ans
