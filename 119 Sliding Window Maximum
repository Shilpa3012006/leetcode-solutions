#optimal solution with T.C O(1) and S.C O(n)
class MinStack:

    def __init__(self):
        self.stack=[]

        self.min=[]

    def push(self, value: int) -> None:
        self.stack.append(value)
        if not self.min or value<=self.min[-1]:
            self.min.append(value)

    def pop(self) -> None:
        if self.stack[-1]==self.min[-1]:
            self.min.pop()
        self.stack.pop()
        
    def top(self) -> int:
        return self.stack[-1]
        
    def getMin(self) -> int:

        return self.min[-1]

        


