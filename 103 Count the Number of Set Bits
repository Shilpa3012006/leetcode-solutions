#1st approach with T.C O(logn) and S.C O(1)
class Solution:
    def countSetBits(self, n: int) -> int:
        count=0

        while n > 0:
            if n % 2 == 1:
                
                count+=1
            
            n //= 2

        return count
#2nd approach with T.C O(logn) and S.C O(logn)(binary representation)
