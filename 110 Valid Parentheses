#optimal solution with T.C O(n) and S.C O(n)
class Solution:
    def isValid(self, s: str) -> bool:
        stack = []
        pairs = {')': '(', '}': '{', ']': '['}

        for i in s:
            if i in '({[':
                stack.append(i)
            else:
                if not stack or stack[-1] != pairs[i]:
                    return False
                stack.pop()

        return not stack
