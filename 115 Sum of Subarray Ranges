class Solution:
    def find_nse(self, arr):
        n = len(arr)
        stack = []
        ans = [n] * n

        for i in range(n - 1, -1, -1):
            while stack and arr[stack[-1]] >= arr[i]:
                stack.pop()

            if stack:
                ans[i] = stack[-1]

            stack.append(i)

        return ans

    # Previous Smaller Element
    def find_pse(self, arr):
        n = len(arr)
        stack = []
        ans = [-1] * n

        for i in range(n):
            while stack and arr[stack[-1]] > arr[i]:
                stack.pop()

            if stack:
                ans[i] = stack[-1]

            stack.append(i)

        return ans

    # Next Greater Element
    def find_nge(self, arr):
        n = len(arr)
        stack = []
        ans = [n] * n

        for i in range(n - 1, -1, -1):
            while stack and arr[stack[-1]] <= arr[i]:
                stack.pop()

            if stack:
                ans[i] = stack[-1]

            stack.append(i)

        return ans

    def find_pge(self, arr):
        n = len(arr)
        stack = []
        ans = [-1] * n

        for i in range(n):
            while stack and arr[stack[-1]] < arr[i]:
                stack.pop()

            if stack:
                ans[i] = stack[-1]

            stack.append(i)

        return ans
    def subArrayRanges(self, nums: List[int]) -> int:
        n = len(nums)

        # For minimum contribution
        nse = self.find_nse(nums)
        pse = self.find_pse(nums)

        # For maximum contribution
        nge = self.find_nge(nums)
        pge = self.find_pge(nums)

        minimum_sum = 0
        maximum_sum = 0

        for i in range(n):

            # Minimum contribution
            left = i - pse[i]
            right = nse[i] - i

            minimum_sum += left * right * nums[i]

            # Maximum contribution
            left = i - pge[i]
            right = nge[i] - i

            maximum_sum += left * right * nums[i]

        return maximum_sum - minimum_sum
